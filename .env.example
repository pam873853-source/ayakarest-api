# ============================================================
# AYAKA API — Environment variables (Powered by AYAKA Sync)
# Salin ke .env untuk lokal, dan isi yang sama di Vercel →
# Project Settings → Environment Variables. JANGAN commit .env.
# ============================================================

# Neon PostgreSQL connection string (wajib sslmode=require). Gunakan pooled URL (-pooler) untuk Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# URL publik website (tanpa garis miring di akhir). Dipakai untuk Magic Link & email.
BASE_URL=https://your-project.vercel.app

# Resend (https://resend.com) — API key & pengirim dari domain yang sudah diverifikasi.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AYAKA API <noreply@yourdomain.com>

# Email owner/admin (informasi kontak). Hak admin TETAP diberikan lewat tabel admin_users.
ADMIN_EMAIL=olpieditz336@gmail.com

# Secret acak minimal 32 karakter — buat dengan: python scripts/generate_secrets.py
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
API_KEY_PEPPER=change-me-to-a-random-string-of-at-least-32-chars
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# production | development  (development = cookie tanpa Secure untuk http://localhost)
ENVIRONMENT=production

# Opsional
# CORS_ORIGINS=https://app-anda.com,https://admin-anda.com   (default: *  — tanpa credentials)
# MAX_BODY_BYTES=1048576
